   "source": [
    "# Python\n",
    "import os\n",
    "import time\n",
    "import random\n",
    "import cv2\n",
    "import requests\n",
    "import click\n",
    "from urllib.parse import urljoin, urlparse\n",
    "from selenium import webdriver\n",
    "from selenium.webdriver.chrome.options import Options\n",
    "from selenium.webdriver.common.by import By\n",
    "\n",
    "# ------------------------------\n",
    "# YOLO (OpenCV DNN) configuration\n",
    "# ------------------------------\n",
    "# Provide your YOLO weights/config files. Example below uses YOLOv3 COCO (person class id=0)\n",
    "# You can replace with any YOLO model supported by OpenCV DNN (ONNX or Darknet).\n",
    "YOLO_WEIGHTS = os.environ.get(\"YOLO_WEIGHTS\", \"yolov3.weights\")\n",
    "YOLO_CFG = os.environ.get(\"YOLO_CFG\", \"yolov3.cfg\")\n",
    "YOLO_NAMES = os.environ.get(\"YOLO_NAMES\", \"coco.names\")\n",
    "\n",
    "PERSON_CLASS_IDS = {0}  # in COCO, class 0 is 'person'\n",
    "CONF_THRESH = 0.35\n",
    "NMS_THRESH = 0.4\n",
    "\n",
    "# ------------------------------\n",
    "# Selenium helpers\n",
    "# ------------------------------\n",
    "def create_driver(headless: bool = True) -> webdriver.Chrome:\n",
    "    chrome_options = Options()\n",
    "    if headless:\n",
    "        chrome_options.add_argument(\"--headless=new\")\n",
    "    chrome_options.add_argument(\"--disable-gpu\")\n",
    "    chrome_options.add_argument(\"--no-sandbox\")\n",
    "    chrome_options.add_argument(\"--window-size=1920,1080\")\n",
    "    driver = webdriver.Chrome(options=chrome_options)\n",
    "    return driver\n",
    "\n",
    "def load_netscape_cookies(driver: webdriver.Chrome, base_url: str, cookie_file_path: str):\n",
    "    \"\"\"\n",
    "    Loads cookies in Netscape format into the Selenium driver.\n",
    "    Cookies must match the domain; we first open base_url so we can set cookies.\n",
    "    \"\"\"\n",
    "    if not os.path.exists(cookie_file_path):\n",
    "        raise FileNotFoundError(f\"Cookie file not found: {cookie_file_path}\")\n",
    "\n",
    "    driver.get(base_url)  # required before adding cookies\n",
    "\n",
    "    with open(cookie_file_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        for line in f:\n",
    "            line = line.strip()\n",
    "            if not line or line.startswith(\"#\"):\n",
    "                continue\n",
    "            parts = line.split(\"\\t\")\n",
    "            if len(parts) != 7:\n",
    "                # Some files may use spaces instead of tabs; try splitting on whitespace\n",
    "                parts = line.split()\n",
    "                if len(parts) != 7:\n",
    "                    continue\n",
    "            domain, flag, path, secure, expiry, name, value = parts\n",
    "            # Selenium requires booleans and ints for some fields\n",
    "            secure_bool = secure.upper() == \"TRUE\"\n",
    "            cookie_dict = {\n",
    "                \"name\": name,\n",
    "                \"value\": value,\n",
    "                \"domain\": domain if domain.startswith(\".\") else domain,\n",
    "                \"path\": path,\n",
    "                \"secure\": secure_bool,\n",
    "            }\n",
    "            try:\n",
    "                if expiry.isdigit():\n",
    "                    cookie_dict[\"expiry\"] = int(expiry)\n",
    "            except Exception:\n",
    "                pass\n",
    "            try:\n",
    "                driver.add_cookie(cookie_dict)\n",
    "            except Exception:\n",
    "                # Ignore cookies that don't match current domain/subdomain\n",
    "                pass\n",
    "\n",
    "    # Refresh to apply cookies\n",
    "    driver.get(base_url)\n",
    "\n",
    "# ------------------------------\n",
    "# Image scraping helpers\n",
    "# ------------------------------\n",
    "def find_image_urls(driver: webdriver.Chrome, base_url: str) -> list[str]:\n",
    "    imgs = driver.find_elements(By.TAG_NAME, \"img\")\n",
    "    urls = []\n",
    "    for img in imgs:\n",
    "        src = img.get_attribute(\"src\") or \"\"\n",
    "        if not src:\n",
    "            continue\n",
    "        # Resolve relative URLs\n",
    "        full = urljoin(base_url, src)\n",
    "        urls.append(full)\n",
    "    # Deduplicate while preserving order\n",
    "    seen = set()\n",
    "    deduped = []\n",
    "    for u in urls:\n",
    "        if u not in seen:\n",
    "            seen.add(u)\n",
    "            deduped.append(u)\n",
    "    return deduped\n",
    "\n",
    "def download_image_bytes(url: str, session: requests.Session) -> bytes | None:\n",
    "    try:\n",
    "        resp = session.get(url, timeout=20)\n",
    "        if resp.status_code == 200 and resp.headers.get(\"content-type\", \"\").startswith(\"image/\"):\n",
    "            return resp.content\n",
    "    except Exception:\n",
    "        return None\n",
    "    return None\n",
    "\n",
    "def ensure_dir(path: str):\n",
    "    os.makedirs(path, exist_ok=True)\n",
    "\n",
    "# ------------------------------\n",
    "# Persistence for processed URLs\n",
    "# ------------------------------\n",
    "def load_processed(file_path: str) -> set[str]:\n",
    "    if not os.path.exists(file_path):\n",
    "        return set()\n",
    "    with open(file_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        return set(line.strip() for line in f if line.strip())\n",
    "\n",
    "def append_processed(file_path: str, url: str):\n",
    "    with open(file_path, \"a\", encoding=\"utf-8\") as f:\n",
    "        f.write(url + \"\\n\")\n",
    "\n",
    "# ------------------------------\n",
    "# YOLO DNN\n",
    "# ------------------------------\n",
    "def load_yolo():\n",
    "    if YOLO_WEIGHTS.lower().endswith(\".onnx\"):\n",
    "        net = cv2.dnn.readNetFromONNX(YOLO_WEIGHTS)\n",
    "        names = _load_class_names(YOLO_NAMES)\n",
    "        return net, names, \"onnx\"\n",
    "    else:\n",
    "        net = cv2.dnn.readNetFromDarknet(YOLO_CFG, YOLO_WEIGHTS)\n",
    "        names = _load_class_names(YOLO_NAMES)\n",
    "        return net, names, \"darknet\"\n",
    "\n",
    "def _load_class_names(names_path: str) -> list[str]:\n",
    "    if not os.path.exists(names_path):\n",
    "        # Fallback minimal names list where index 0 is person\n",
    "        return [\"person\"]\n",
    "    with open(names_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        return [line.strip() for line in f if line.strip()]\n",
    "\n",
    "def detect_person_opencv_dnn(image_bgr, net, names, backend: str) -> bool:\n",
    "    h, w = image_bgr.shape[:2]\n",
    "    # Standard YOLOv3 input size; for ONNX it may vary; adjust if needed\n",
    "    blob = cv2.dnn.blobFromImage(image_bgr, 1 / 255.0, (416, 416), swapRB=True, crop=False)\n",
    "    net.setInput(blob)\n",
    "\n",
    "    if backend == \"darknet\":\n",
    "        ln = net.getUnconnectedOutLayersNames()\n",
    "        layer_outputs = net.forward(ln)\n",
    "        boxes, confidences, class_ids = [], [], []\n",
    "        for output in layer_outputs:\n",
    "            for detection in output:\n",
    "                scores = detection[5:]\n",
    "                class_id = int(scores.argmax())\n",
    "                confidence = float(scores[class_id])\n",
    "                if confidence >= CONF_THRESH and class_id in PERSON_CLASS_IDS:\n",
    "                    box = detection[0:4]  # center x, center y, width, height (normalized)\n",
    "                    center_x, center_y, width, height = box\n",
    "                    x = int((center_x - width / 2) * w)\n",
    "                    y = int((center_y - height / 2) * h)\n",
    "                    bw = int(width * w)\n",
    "                    bh = int(height * h)\n",
    "                    boxes.append([x, y, bw, bh])\n",
    "                    confidences.append(confidence)\n",
    "                    class_ids.append(class_id)\n",
    "        idxs = cv2.dnn.NMSBoxes(boxes, confidences, CONF_THRESH, NMS_THRESH)\n",
    "        return len(idxs) > 0 if isinstance(idxs, (list, tuple)) else (idxs is not None and len(idxs) > 0)\n",
    "    else:\n",
    "        # Generic ONNX case: attempt to parse standard YOLO ONNX outputs\n",
    "        outs = net.forward(net.getUnconnectedOutLayersNames())\n",
    "        boxes, confidences, class_ids = [], [], []\n",
    "        for out in outs:\n",
    "            for det in out:\n",
    "                scores = det[5:]\n",
    "                class_id = int(scores.argmax())\n",
    "                confidence = float(scores[class_id])\n",
    "                if confidence >= CONF_THRESH and class_id in PERSON_CLASS_IDS:\n",
    "                    cx, cy, bw, bh = det[:4]\n",
    "                    x = int((cx - bw / 2) * w)\n",
    "                    y = int((cy - bh / 2) * h)\n",
    "                    boxes.append([x, y, int(bw * w), int(bh * h)])\n",
    "                    confidences.append(confidence)\n",
    "                    class_ids.append(class_id)\n",
    "        idxs = cv2.dnn.NMSBoxes(boxes, confidences, CONF_THRESH, NMS_THRESH)\n",
    "        return len(idxs) > 0 if isinstance(idxs, (list, tuple)) else (idxs is not None and len(idxs) > 0)\n",
    "\n",
    "# ------------------------------\n",
    "# Main workflow\n",
    "# ------------------------------\n",
    "@click.command()\n",
    "@click.option(\"--url\", required=True, help=\"Target webpage URL containing images.\")\n",
    "@click.option(\"--cookies-file\", \"cookies_file\", required=True, help=\"Netscape-format cookies txt path.\")\n",
    "@click.option(\"--output-dir\", \"output_dir\", default=\"downloaded_people\", show_default=True, help=\"Folder to save images with people.\")\n",
    "@click.option(\"--processed-log\", \"processed_log\", default=\"processed_images.txt\", show_default=True, help=\"File storing processed image URLs.\")\n",
    "@click.option(\"--headless/--no-headless\", default=True, show_default=True, help=\"Run browser headless.\")\n",
    "def main(url, cookies_file, output_dir, processed_log, headless):\n",
    "    ensure_dir(output_dir)\n",
    "\n",
    "    print(f\"[INFO] Loading YOLO...\")\n",
    "    net, names, backend = load_yolo()\n",
    "\n",
    "    print(f\"[INFO] Starting Selenium...\")\n",
    "    driver = create_driver(headless=headless)\n",
    "    try:\n",
    "        load_netscape_cookies(driver, url, cookies_file)\n",
    "        print(f\"[INFO] Collecting images from: {url}\")\n",
    "        image_urls = find_image_urls(driver, url)\n",
    "        print(f\"[INFO] Found {len(image_urls)} image(s).\")\n",
    "\n",
    "        processed = load_processed(processed_log)\n",
    "        session = requests.Session()\n",
    "\n",
    "        for idx, img_url in enumerate(image_urls, start=1):\n",
    "            if img_url in processed:\n",
    "                continue\n",
    "\n",
    "            # Random delay 2–5 seconds\n",
    "            delay = random.uniform(2.0, 5.0)\n",
    "            time.sleep(delay)\n",
    "\n",
    "            data = download_image_bytes(img_url, session)\n",
    "            if not data:\n",
    "                append_processed(processed_log, img_url)\n",
    "                continue\n",
    "\n",
    "            # Decode image\n",
    "            image_array = cv2.imdecode(\n",
    "                np.frombuffer(data, dtype=np.uint8), cv2.IMREAD_COLOR\n",
    "            )\n",
    "            if image_array is None:\n",
    "                append_processed(processed_log, img_url)\n",
    "                continue\n",
    "\n",
    "            has_person = detect_person_opencv_dnn(image_array, net, names, backend)\n",
    "            if has_person:\n",
    "                # Show and wait for key\n",
    "                preview = image_array.copy()\n",
    "                cv2.imshow(\"Detected Image (press 's' to save, any other key to skip)\", preview)\n",
    "                key = cv2.waitKey(0) & 0xFF\n",
    "                cv2.destroyAllWindows()\n",
    "\n",
    "                if key == ord('s'):\n",
    "                    # Save to output_dir; create a safe filename\n",
    "                    parsed = urlparse(img_url)\n",
    "                    base_name = os.path.basename(parsed.path) or f\"image_{idx}.jpg\"\n",
    "                    # Ensure extension\n",
    "                    if not os.path.splitext(base_name)[1]:\n",
    "                        base_name += \".jpg\"\n",
    "                    save_path = os.path.join(output_dir, base_name)\n",
    "                    # If duplicate name, append index\n",
    "                    root, ext = os.path.splitext(save_path)\n",
    "                    c = 1\n",
    "                    while os.path.exists(save_path):\n",
    "                        save_path = f\"{root}_{c}{ext}\"\n",
    "                        c += 1\n",
    "                    cv2.imwrite(save_path, image_array)\n",
    "                    print(f\"[SAVED] {save_path}\")\n",
    "                else:\n",
    "                    print(f\"[SKIPPED] Person found but not saved: {img_url}\")\n",
    "\n",
    "            # Mark as processed either way\n",
    "            append_processed(processed_log, img_url)\n",
    "\n",
    "        print(\"[DONE] Processing complete.\")\n",
    "\n",
    "    finally:\n",
    "        try:\n",
    "            driver.quit()\n",
    "        except Exception:\n",
    "            pass\n",
    "\n",
    "# Required for cv2.imdecode\n",
    "import numpy as np\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()\n"
   ],
